    "iframeCode": "<iframe srcdoc=\"<!DOCTYPE html><html><head><meta charset='UTF-8'><meta name='viewport' content='width=device-width,initial-scale=1'><style>body{margin:0;background:#18181b;color:#f4f4f5;font-family:system-ui,-apple-system,sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;user-select:none}.container{max-width:400px;width:90%;text-align:center}.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}h1{margin:0;font-size:32px;color:#f59e0b}.scores{display:flex;gap:8px}.score-box{background:#27272a;padding:6px 12px;border-radius:8px;font-size:12px;color:#a1a1aa}.score-box span{display:block;font-size:18px;font-weight:bold;color:#fff}.grid{background:#27272a;border-radius:12px;padding:10px;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;aspect-ratio:1;position:relative}.tile{background:#3f3f46;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:bold;transition:all 0.1s ease;color:#f4f4f5}.t-2{background:#e2e8f0;color:#1e293b}.t-4{background:#cbd5e1;color:#1e293b}.t-8{background:#f87171;color:#fff}.t-16{background:#ef4444;color:#fff}.t-32{background:#f97316;color:#fff}.t-64{background:#ea580c;color:#fff}.t-128{background:#eab308;color:#fff;font-size:20px}.t-256{background:#eab308;color:#fff;font-size:20px;box-shadow:0 0 10px #eab308}.t-512{background:#eab308;color:#fff;font-size:20px}.t-1024{background:#10b981;color:#fff;font-size:16px}.t-2048{background:#3b82f6;color:#fff;font-size:16px;box-shadow:0 0 15px #3b82f6}.btn{background:#f59e0b;color:#000;border:none;padding:8px 16px;border-radius:6px;font-weight:bold;cursor:pointer;margin-top:12px}.game-over{position:absolute;inset:0;background:rgba(0,0,0,0.85);border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:28px;font-weight:bold;color:#ef4444;display:none}</style></head><body><div class='container'><div class='header'><h1>2048</h1><div class='scores'><div class='score-box'>SCORE<span id='score'>0</span></div><div class='score-box'>BEST<span id='best'>0</span></div></div></div><div class='grid' id='grid'><div class='game-over' id='gameOver'><div>Game Over!</div><button class='btn' onclick='init()'>Try Again</button></div></div><button class='btn' onclick='init()'>New Game</button></div><script>let board=Array(16).fill(0),score=0,best=parseInt(localStorage.getItem('2048_best')||'0');document.getElementById('best').innerText=best;function init(){board=Array(16).fill(0);score=0;document.getElementById('score').innerText=0;document.getElementById('gameOver').style.display='none';addTile();addTile();render()}function addTile(){let empty=board.map((v,i)=>v===0?i:null).filter(v=>v!==null);if(empty.length){let idx=empty[Math.floor(Math.random()*empty.length)];board[idx]=Math.random()<0.9?2:4}}function render(){let g=document.getElementById('grid');let go=document.getElementById('gameOver');g.innerHTML='';g.appendChild(go);board.forEach(v=>{let d=document.createElement('div');d.className='tile '+(v?'t-'+v:'');d.innerText=v||'';g.appendChild(d)})}function slide(row){let arr=row.filter(v=>v);for(let i=0;i<arr.length-1;i++){if(arr[i]===arr[i+1]){arr[i]*=2;score+=arr[i];arr[i+1]=0}}arr=arr.filter(v=>v);while(arr.length<4)arr.push(0);return arr}function move(dir){let old=JSON.stringify(board);for(let i=0;i<4;i++){let row=[];if(dir==='left'||dir==='right'){for(let j=0;j<4;j++)row.push(board[i*4+j]);if(dir==='right')row.reverse();row=slide(row);if(dir==='right')row.reverse();for(let j=0;j<4;j++)board[i*4+j]=row[j]}else{for(let j=0;j<4;j++)row.push(board[j*4+i]);if(dir==='down')row.reverse();row=slide(row);if(dir==='down')row.reverse();for(let j=0;j<4;j++)board[j*4+i]=row[j]}}if(JSON.stringify(board)!==old){addTile();document.getElementById('score').innerText=score;if(score>best){best=score;localStorage.setItem('2048_best',best);document.getElementById('best').innerText=best}render();checkGameOver()}}function checkGameOver(){if(board.includes(0))return;for(let i=0;i<4;i++){for(let j=0;j<4;j++){let v=board[i*4+j];if(j<3&&v===board[i*4+j+1])return;if(i<3&&v===board[(i+1)*4+j])return}}document.getElementById('gameOver').style.display='flex'}window.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'||e.key==='a')move('left');if(e.key==='ArrowRight'||e.key==='d')move('right');if(e.key==='ArrowUp'||e.key==='w')move('up');if(e.key==='ArrowDown'||e.key==='s')move('down')});init()</script></body></html>\" width=\"100%\" height=\"100%\" frameborder=\"0\" allowfullscreen></iframe>"
