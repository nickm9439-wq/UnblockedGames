ht){lives--;document.getElementById('l').innerText=lives;if(lives<=0){alert('Game Over! Score: '+score);location.reload()}else{ball.x=200;ball.y=300;ball.dy=-3}}}function loop(){draw();update();requestAnimationFrame(loop)}loop()</script></body></html>\" width=\"100%\" height=\"100%\" frameborder=\"0\" allowfullscreen></iframe>"
