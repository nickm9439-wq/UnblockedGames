illStyle='#fff';ctx.font='bold 28px sans-serif';ctx.textAlign='center';if(state==='play'){ctx.fillText(score,c.width/2,50)}else if(state==='start'){ctx.fillText('FLAPPY DASH',c.width/2,200);ctx.font='16px sans-serif';ctx.fillText('Click or press Space to Start',c.width/2,240)}else if(state==='over'){ctx.fillText('GAME OVER',c.width/2,180);ctx.font='18px sans-serif';ctx.fillText('Score: '+score+' | Best: '+best,c.width/2,220);ctx.font='14px sans-serif';ctx.fillText('Click to Try Again',c.width/2,260)}requestAnimationFrame(loop)}loop()</script></body></html>\" width=\"100%\" height=\"100%\" frameborder=\"0\" allowfullscreen></iframe>"
