).innerText='AI Wins!';active=false;return}if(!board.includes('')){document.getElementById('st').innerText='Draw!';active=false;return}document.getElementById('st').innerText='Your Turn (X)'}}function checkWin(p){const w=[[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]];return w.some(c=>c.every(i=>board[i]===p))}function render(){let cells=document.querySelectorAll('.cell');cells.forEach((c,i)=>{c.innerText=board[i];c.style.color=board[i]==='X'?'#f43f5e':'#38bdf8'})}init()</script></body></html>\" width=\"100%\" height=\"100%\" frameborder=\"0\" allowfullscreen></iframe>"
