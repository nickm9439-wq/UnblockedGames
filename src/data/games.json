c>=0&&nc<cols&&board[nr][nc].mine)cnt++}}board[r][c].count=cnt}}}}function render(){for(let r=0;r<rows;r++){for(let c=0;c<cols;c++){let d=document.querySelector(`[data-r='${r}'][data-c='${c}']`);let cell=board[r][c];if(cell.revealed){d.classList.add('revealed');if(cell.mine){d.classList.add('mine');d.innerText='💣'}else if(cell.count>0){d.innerText=cell.count;const colors=['','#3b82f6','#22c55e','#ef4444','#a855f7','#f59e0b'];d.style.color=colors[cell.count]||'#fff'}}else if(cell.flagged){d.innerText='🚩'}else{d.innerText=''}}}}function clickCell(r,c){let cell=board[r][c];if(cell.revealed||cell.flagged)return;cell.revealed=true;revealedCount++;if(cell.mine){render();alert('Game Over! You hit a mine.');return}if(cell.count===0){for(let dr=-1;dr<=1;dr++){for(let dc=-1;dc<=1;dc++){let nr=r+dr,nc=c+dc;if(nr>=0&&nr<rows&&nc>=0&&nc<cols&&!board[nr][nc].revealed)clickCell(nr,nc)}}}render();if(revealedCount===rows*cols-mines){alert('Congratulations! You cleared all mines!')}}function flagCell(r,c){let cell=board[r][c];if(cell.revealed)return;cell.flagged=!cell.flagged;render()}init()</script></body></html>\" width=\"100%\" height=\"100%\" frameborder=\"0\" allowfullscreen></iframe>"
